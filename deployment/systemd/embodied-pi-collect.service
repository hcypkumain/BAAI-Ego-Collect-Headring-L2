[Unit]
Description=Orange Pi continuous collection without stimulus
Wants=network-online.target bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/Desktop/Embodied-Brain-Collect-main
ExecStart=/bin/bash "/home/orangepi/Desktop/Embodied-Brain-Collect-main/orangepi/scripts/run.sh" service
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
KillMode=mixed
TimeoutStopSec=1900
Environment=PYTHONUNBUFFERED=1
UMask=0022
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
