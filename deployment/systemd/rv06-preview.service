[Unit]
Description=Read-only latest-frame thumbnails for the RV06 terminal
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/Desktop/Embodied-Brain-Collect-main/orangepi
Environment=ROS_MASTER_URI=http://127.0.0.1:11311
Environment=PYTHONUNBUFFERED=1
Environment=ROS_LOG_DIR=/run/rv06-preview/ros
RuntimeDirectory=rv06-preview
RuntimeDirectoryMode=0700
# Install the reviewed sidecar at this task-specific path before enabling.
ExecStart=/bin/bash -c 'source /opt/ros/noetic/setup.bash && exec /home/orangepi/Desktop/Embodied-Brain-Collect-main/orangepi/.venvs/ros/bin/python -u /opt/rv06-preview/preview_sidecar.py --bind 192.168.250.1 --port 8766'
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
KillSignal=SIGTERM
Nice=5
NoNewPrivileges=true
PrivateTmp=true
# Limit only the optional viewer. Verify actual RSS before enabling this cap.
MemoryMax=128M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rv06-preview

[Install]
WantedBy=multi-user.target
