{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:headring:device-registry:v1",
  "title": "Explicit device registry (semantic validation also required)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "devices"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "devices": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/device"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "nonempty": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$"},
    "grant": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "destination", "reason", "owner", "expiry"],
      "properties": {
        "operation": {"const": "upload"},
        "destination": {"enum": ["EGOL2", "EGOL3_hand"]},
        "reason": {"$ref": "#/$defs/nonempty"},
        "owner": {"$ref": "#/$defs/nonempty"},
        "expiry": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$"}]}
      },
      "allOf": [{"if": {"properties": {"expiry": {"type": "null"}}}, "then": {"properties": {"reason": {"pattern": "^legacy:.*[^\\s].*$", "minLength": 8}}}}]
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["device_id", "ssh_alias", "address", "ssh_user", "host_key_alias", "capabilities", "enrolled", "receive_member", "monitor_enabled", "upload_grants"],
      "properties": {
        "device_id": {"type": "string", "pattern": "^cp_[0-9]{4}$"},
        "ssh_alias": {"$ref": "#/$defs/identifier"},
        "address": {"oneOf": [{"type": "string", "format": "ipv4"}, {"type": "string", "format": "ipv6"}], "not": {"pattern": "%"}},
        "ssh_user": {"$ref": "#/$defs/identifier"},
        "host_key_alias": {"$ref": "#/$defs/identifier"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "enrolled": {"type": "boolean"},
        "receive_member": {"type": "boolean"},
        "monitor_enabled": {"type": "boolean"},
        "upload_grants": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/grant"}}
      }
    }
  }
}
