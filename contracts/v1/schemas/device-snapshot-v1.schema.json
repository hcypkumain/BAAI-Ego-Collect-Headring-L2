{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://headring.invalid/contracts/device-snapshot-v1.schema.json",
 "type":"object","additionalProperties":false,
 "required":["schema_version","device_id","boot_id","controller_instance","seq","time","sample","mode","lifecycle","recording_active","state_revision","session","progress","resources","health","roles","version","usb_transport","queues","recovery_state","data_filesystem_state"],
 "properties":{
  "schema_version":{"const":"1.0"},"device_id":{"type":"string","pattern":"^cp_[0-9]{4}$"},
  "boot_id":{"$ref":"common-v1.schema.json#/$defs/nullableUuid"},"controller_instance":{"$ref":"common-v1.schema.json#/$defs/nullableUuid"},"seq":{"$ref":"common-v1.schema.json#/$defs/count"},"time":{"$ref":"common-v1.schema.json#/$defs/time"},"sample":{"$ref":"common-v1.schema.json#/$defs/sample"},
  "mode":{"enum":["eeg","emg","unknown"]},"lifecycle":{"enum":["idle","preparing","prepared","impedance","arming","recording","stopping","finalizing","fault","unknown"]},"recording_active":{"type":["boolean","null"]},"state_revision":{"$ref":"common-v1.schema.json#/$defs/count"},
  "session":{"$ref":"common-v1.schema.json#/$defs/context"},
  "progress":{"type":"object","additionalProperties":false,"required":["sample","total","completed","pending","reserved","remaining","failed_attempts","reason"],"properties":{"sample":{"$ref":"common-v1.schema.json#/$defs/sample"},"total":{"$ref":"common-v1.schema.json#/$defs/count"},"completed":{"$ref":"common-v1.schema.json#/$defs/count"},"pending":{"$ref":"common-v1.schema.json#/$defs/count"},"reserved":{"$ref":"common-v1.schema.json#/$defs/count"},"remaining":{"$ref":"common-v1.schema.json#/$defs/count"},"failed_attempts":{"$ref":"common-v1.schema.json#/$defs/count"},"reason":{"$ref":"common-v1.schema.json#/$defs/reason"}}},
  "resources":{"type":"object","additionalProperties":false,"required":["disk_sample","disk_volume_id","disk_free_bytes","disk_available_bytes","ram_sample","ram_mem_available_bytes"],"properties":{"disk_sample":{"$ref":"common-v1.schema.json#/$defs/sample"},"disk_volume_id":{"$ref":"common-v1.schema.json#/$defs/nullableId"},"disk_free_bytes":{"$ref":"common-v1.schema.json#/$defs/count"},"disk_available_bytes":{"$ref":"common-v1.schema.json#/$defs/count"},"ram_sample":{"$ref":"common-v1.schema.json#/$defs/sample"},"ram_mem_available_bytes":{"$ref":"common-v1.schema.json#/$defs/count"}}},
   "health":{"type":"object","additionalProperties":false,"required":["sample","camera","eeg","impedance","log_dropped"],"properties":{"sample":{"$ref":"common-v1.schema.json#/$defs/sample"},"camera":{"enum":["ok","degraded","error","unknown"]},"eeg":{"enum":["ok","degraded","error","not_applicable","unknown"]},"log_dropped":{"$ref":"common-v1.schema.json#/$defs/count"},"impedance":{"type":"object","additionalProperties":false,"required":["measurement_id","owner_run","session_id","profile_epoch","quality_version","quality","sample","can_review","reason"],"properties":{"measurement_id":{"$ref":"common-v1.schema.json#/$defs/nullableId"},"owner_run":{"$ref":"common-v1.schema.json#/$defs/nullableId"},"session_id":{"$ref":"common-v1.schema.json#/$defs/nullableId"},"profile_epoch":{"$ref":"common-v1.schema.json#/$defs/count"},"quality_version":{"$ref":"common-v1.schema.json#/$defs/nullableId"},"quality":{"enum":["pass","warn","error","unknown","not_applicable"]},"sample":{"$ref":"common-v1.schema.json#/$defs/sample"},"can_review":{"type":["boolean","null"]},"reason":{"$ref":"common-v1.schema.json#/$defs/reason"}}}}},
  "roles":{"type":"object","additionalProperties":false,"required":["sample","left","right"],"properties":{"sample":{"$ref":"common-v1.schema.json#/$defs/sample"},"left":{"$ref":"#/$defs/role"},"right":{"$ref":"#/$defs/role"}}},
  "version":{"type":"object","additionalProperties":false,"required":["sample","base_commit","overlay_manifest_sha256","installed_manifest_sha256","runtime_manifest_sha256","approved_release_id"],"properties":{"sample":{"$ref":"common-v1.schema.json#/$defs/sample"},"base_commit":{"type":["string","null"],"pattern":"^[0-9a-f]{40}$"},"overlay_manifest_sha256":{"$ref":"common-v1.schema.json#/$defs/nullableHash"},"installed_manifest_sha256":{"$ref":"common-v1.schema.json#/$defs/nullableHash"},"runtime_manifest_sha256":{"$ref":"common-v1.schema.json#/$defs/nullableHash"},"approved_release_id":{"$ref":"common-v1.schema.json#/$defs/nullableId"}}},
  "usb_transport":{"type":"object","additionalProperties":false,"required":["sample","configured","current","state","reason"],"properties":{"sample":{"$ref":"common-v1.schema.json#/$defs/sample"},"configured":{"enum":["adb","usb_tether","unknown"]},"current":{"enum":["adb","usb_tether","loopback","none","unknown"]},"state":{"enum":["absent","identifying","no_address","addressed","ambiguous","stale","error","unknown"]},"reason":{"$ref":"common-v1.schema.json#/$defs/reason"}}},
  "queues":{"type":"object","additionalProperties":false,"required":["sample","receipt_pending","handoff_pending","failed_attempts"],"properties":{"sample":{"$ref":"common-v1.schema.json#/$defs/sample"},"receipt_pending":{"$ref":"common-v1.schema.json#/$defs/count"},"handoff_pending":{"$ref":"common-v1.schema.json#/$defs/count"},"failed_attempts":{"$ref":"common-v1.schema.json#/$defs/count"}}},
  "recovery_state":{"enum":["normal","reconciling","maintenance_required","unknown"]},"data_filesystem_state":{"enum":["ok","missing","readonly","io_error","unknown"]}
 },
 "$defs":{"role":{"type":"object","additionalProperties":false,"required":["binding_id","confirmed","calibration_valid","calibration_version","profile_epoch","proof_boot_id","reason"],"properties":{"binding_id":{"$ref":"common-v1.schema.json#/$defs/nullableId"},"confirmed":{"type":["boolean","null"]},"calibration_valid":{"type":["boolean","null"]},"calibration_version":{"$ref":"common-v1.schema.json#/$defs/nullableId"},"profile_epoch":{"$ref":"common-v1.schema.json#/$defs/count"},"proof_boot_id":{"$ref":"common-v1.schema.json#/$defs/nullableUuid"},"reason":{"$ref":"common-v1.schema.json#/$defs/reason"}}}}
}
