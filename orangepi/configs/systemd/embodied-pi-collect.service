[Unit]
Description=Orange Pi continuous collection without stimulus
Wants=network-online.target bluetooth.service seeker_imu.service seeker_cam_bridge.service
After=network-online.target bluetooth.service seeker_imu.service seeker_cam_bridge.service display-manager.service sound.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@PROJECT@
ExecStart=/bin/bash "@ROOT@/scripts/run.sh" service
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
KillMode=mixed
TimeoutStopSec=1900
Environment=PYTHONUNBUFFERED=1
UMask=0022
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
