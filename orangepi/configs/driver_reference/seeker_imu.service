[Unit]
Description=Seeker IMU Sensor (ROS launch)
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/bin/bash -lc 'source /opt/ros/noetic/setup.bash && export ROS_MASTER_URI=http://localhost:11311 && roslaunch seeker_sensors imu.launch'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
